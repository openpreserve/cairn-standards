# Copy to deploy/.env and fill in. .env is git-ignored.

# Which published images to run. Required by docker-compose.ghcr.yml, which has no default:
# `latest` means "newest build of main", not "newest release", because a release tag
# deliberately does not move it, and defaulting to it would silently migrate a host from
# released images onto continuous builds of main.
#
# Setting it here rather than on the command line matters: it is required by every compose
# subcommand, so a tag known only to the `up` that started the stack leaves you unable to
# `down`, `stop` or `logs` it without remembering which one that was.
#
# Accepts exactly what .github/workflows/publish.yml produces:
#   0.2.0          a release, from a v0.2.0 git tag
#   0.2            the minor line, moves with each patch release
#   sha-<40 hex>   a specific commit; note the prefix, a bare sha is not a tag
#   latest         newest build of the default branch, never set by a release tag
#
# The default is `latest` because nothing has been released yet: naming a version here that
# GHCR does not hold makes the documented deploy path fail with "manifest unknown", and
# pinning this to the in-development version would recreate that on every release, for the
# whole window between merging the bump and pushing the tag. Change it to the version number
# once a v* tag exists - pinning a release is the right habit for a service whose promise is
# that published bytes do not move.
CAIRN_TAG=latest

# Cloudflare Tunnel token (Zero Trust > Networks > Tunnels > your tunnel).
# Required only when running with:  docker compose --profile tunnel up -d
CLOUDFLARE_TUNNEL_TOKEN=

# Optional: a GitHub token to lift API rate limits during sync (public repos still
# work without it, just with the lower unauthenticated limit).
GITHUB_TOKEN=
