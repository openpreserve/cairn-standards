# Copy to deploy/.env and fill in. .env is git-ignored.

# Cloudflare Tunnel token (Zero Trust > Networks > Tunnels > your tunnel).
# Required only when running with:  docker compose --profile tunnel up -d
CLOUDFLARE_TUNNEL_TOKEN=

# Optional: a GitHub token to lift API rate limits during sync (public repos still
# work without it, just with the lower unauthenticated limit).
GITHUB_TOKEN=
